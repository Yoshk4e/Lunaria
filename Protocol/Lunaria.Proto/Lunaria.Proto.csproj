<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Protobuf messages and command ID bindings.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.1" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="proto/*.proto" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="proto/*.proto" ProtoRoot="proto" GrpcServices="None" />
  </ItemGroup>

</Project>
