{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Lunaria.GameServer.Net": "Information"
    }
  },
  "GameServer": {
    "GatewayUrl": "http://127.0.0.1:10020",
    "ServerIp": "127.0.0.1",
    "ServerRegion": "local",
    "Port": 30000,
    "ScenePort": 30002,
    "MaxPlayers": 2000,
    "MaxPendingHandshakes": 1024,
    "HandshakeTimeoutSeconds": 30,
    "ListenBacklog": 2048,
    "AcceptLoops": 4,
    "SessionQueueDepth": 256,
    "AssetsDir": "assets",
    "DatabasePath": "game_server.db"
  }
}
